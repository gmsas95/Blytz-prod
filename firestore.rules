rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own profile data
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || true);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Sellers collection
    match /sellers/{sellerId} {
      // Authenticated users can read their own seller profile
      allow read: if request.auth != null && request.auth.uid == sellerId;
      // Anyone can read public seller profiles
      allow read: if true;
      // Sellers can write their own profile
      allow write: if request.auth != null && request.auth.uid == sellerId;
    }

    // Products collection
    match /products/{productId} {
      // Anyone can read products
      allow read: if true;
      // Only sellers can create products
      allow create: if request.auth != null && request.auth.token.seller == true;
      // Only the product owner can update/delete their products
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // Streams collection
    match /streams/{streamId} {
      // Anyone can read public streams
      allow read: if true;
      // Only verified sellers can create streams
      allow create: if request.auth != null && request.auth.token.seller == true;
      // Only the stream owner can update/delete their streams
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // Livestreams collection
    match /livestreams/{livestreamId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.token.seller == true;
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // Auctions collection
    match /auctions/{auctionId} {
      // Anyone can read public auction data
      allow read: if true;

      // Only verified sellers can create auctions
      allow create: if request.auth != null && request.auth.token.seller == true;

      // Only the auction owner can update or delete their own auctions
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;

      // Bids subcollection (within auctions)
      match /bids/{bidId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      // Chat Messages subcollection (within auctions)
      match /chatMessages/{messageId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Orders collection
    match /orders/{orderId} {
      // Users can read their own orders or orders they're selling
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.sellerId);
      
      // Only the system can create orders (via Cloud Functions)
      allow create: if false;
      
      // Only sellers and buyers can update their own orders
      allow update: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.sellerId);
      
      // Orders cannot be deleted
      allow delete: if false;
    }

    // Payments collection - SECURED
    match /payments/{paymentId} {
      // Only authenticated users involved in the transaction can read payments
      allow read: if request.auth != null && (
        // Check if user is the buyer (from order)
        (exists(/databases/$(database)/documents/orders/$(resource.data.orderId)) && 
         get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.userId == request.auth.uid) ||
        // Check if user is the seller (from order)
        (exists(/databases/$(database)/documents/orders/$(resource.data.orderId)) && 
         get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.sellerId == request.auth.uid) ||
        // Admin override
        hasRole('admin', request.auth)
      );
      
      // Only the system can create payments (via Cloud Functions/webhooks)
      allow create: if false;
      
      // Payments cannot be updated or deleted
      allow update, delete: if false;
    }

    // Refunds collection
    match /refunds/{refundId} {
      // Only authenticated users involved in the transaction can read refunds
      allow read: if request.auth != null && (
        // User must be authenticated
        request.auth != null &&
        // Check if user is the buyer (from order)
        (exists(/databases/$(database)/documents/orders/$(resource.data.orderId)) && 
         get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.userId == request.auth.uid) ||
        // Check if user is the seller (from order)
        (exists(/databases/$(database)/documents/orders/$(resource.data.orderId)) && 
         get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.sellerId == request.auth.uid) ||
        // Admin override
        request.auth.token.admin == true
      );
      
      // Users can create refund requests for their own orders
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId &&
        exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid &&
        // Ensure order is in correct state for refund
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status in ['paid', 'shipped', 'delivered'];
      
      // Only sellers can update refund requests (approve/reject)
      allow update: if request.auth != null && 
        exists(/databases/$(database)/documents/orders/$(resource.data.orderId)) &&
        get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.sellerId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['status', 'processedAt', 'processedBy', 'notes', 'refundTransactionId', 'failureReason']) &&
        // Validate status transitions
        resource.data.status == 'pending' && 
        request.resource.data.status in ['approved', 'rejected'];
      
      // Refunds cannot be deleted
      allow delete: if false;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      // Users can write their own notifications (mark as read)
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Shipping addresses (as subcollection of users)
    match /users/{userId}/shippingAddresses/{addressId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Payment methods (as subcollection of users)
    match /users/{userId}/paymentMethods/{methodId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Additional security rules for critical business data
    
    // Bidding restrictions - prevent bid manipulation
    match /auctions/{auctionId}/bids/{bidId} {
      allow read: if true;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount > 0
        && isValidBidAmount(auctionId, request.resource.data.amount)
        && !isAuctionEnded(auctionId);
      allow update, delete: if false; // Bids cannot be modified once placed
    }

    // Chat message restrictions - prevent spam
    match /auctions/{auctionId}/chatMessages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && !isUserBanned(auctionId, request.auth.uid);
      allow update, delete: if false; // Messages cannot be edited/deleted
    }

    // System collections - admin only
    match /system/{document=**} {
      allow read, write: if hasRole('admin', request.auth);
    }

    // Helper functions
    function hasRole(role, auth) {
      return auth != null && auth.token.role == role;
    }

    function isValidBidAmount(auctionId, bidAmount) {
      return exists(/databases/$(database)/documents/auctions/$(auctionId)) &&
        bidAmount > get(/databases/$(database)/documents/auctions/$(auctionId)).data.currentPrice;
    }

    function isAuctionEnded(auctionId) {
      return exists(/databases/$(database)/documents/auctions/$(auctionId)) &&
        get(/databases/$(database)/documents/auctions/$(auctionId)).data.endTime < request.time;
    }

    function isUserBanned(auctionId, userId) {
      return exists(/databases/$(database)/documents/auctions/$(auctionId)) &&
        get(/databases/$(database)/documents/auctions/$(auctionId)).data.bannedUsers != null &&
        userId in get(/databases/$(database)/documents/auctions/$(auctionId)).data.bannedUsers;
    }
  }
}