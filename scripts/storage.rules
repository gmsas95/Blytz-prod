rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User profile images - users can only access their own
    match /users/{userId}/profile-images/{imageName} {
      allow read: if true; // Public access for profile images
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024  // 5MB limit
        && isValidImageType(request.resource.contentType);
    }
    
    // Seller verification documents - only the seller and admins can access
    match /sellers/{sellerId}/verification/{documentId} {
      allow read: if request.auth != null && 
        (request.auth.uid == sellerId || hasRole('admin', request.auth));
      allow write: if request.auth != null && request.auth.uid == sellerId
        && request.resource.size < 10 * 1024 * 1024  // 10MB limit
        && isValidDocumentType(request.resource.contentType);
    }
    
    // Product images - sellers can manage their own, public can view
    match /products/{productId}/images/{imageName} {
      allow read: if true;  // Public access for product images
      allow write: if request.auth != null && isProductOwner(productId, request.auth.uid)
        && request.resource.size < 5 * 1024 * 1024  // 5MB limit
        && isValidImageType(request.resource.contentType);
    }
    
    // Stream thumbnails - sellers can manage, public can view
    match /streams/{streamId}/thumbnails/{thumbnailName} {
      allow read: if true;  // Public access for thumbnails
      allow write: if request.auth != null && isStreamOwner(streamId, request.auth.uid)
        && request.resource.size < 2 * 1024 * 1024  // 2MB limit
        && isValidImageType(request.resource.contentType);
    }
    
    // Live stream recordings - only stream owner and admin access
    match /streams/{streamId}/recordings/{recordingName} {
      allow read: if request.auth != null && (
        isStreamOwner(streamId, request.auth.uid) ||
        hasRole('admin', request.auth)
      );
      allow write: if request.auth != null &&
        isStreamOwner(streamId, request.auth.uid) &&
        request.resource.size < 100 * 1024 * 1024;  // 100MB max
    }
    
    // Order-related documents (receipts, invoices) - only involved parties
    match /orders/{orderId}/documents/{documentName} {
      allow read: if request.auth != null && 
        (isOrderParticipant(orderId, request.auth.uid) || hasRole('admin', request.auth));
      allow write: if request.auth != null &&
        isOrderSeller(orderId, request.auth.uid) &&
        request.resource.size < 5 * 1024 * 1024 &&  // 5MB limit
        isValidDocumentType(request.resource.contentType);
    }
    
    // Temporary upload staging - auto-cleanup after 24 hours
    match /temp/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;  // 10MB limit
      allow read: if request.auth != null && request.auth.uid == userId
        && request.time < resource.timeCreated + duration.value(24, 'hours');
    }
    
    // Admin-only access for system files
    match /system/{allPaths=**} {
      allow read, write: if request.auth != null && hasRole('admin', request.auth);
    }
    
    // Helper functions
    function hasRole(role, auth) {
      return auth.token.role == role;
    }

    function isValidImageType(contentType) {
      return contentType.matches('image/.*') ||
        contentType == 'image/jpeg' ||
        contentType == 'image/png' ||
        contentType == 'image/webp' ||
        contentType == 'image/gif';
    }

    function isValidDocumentType(contentType) {
      return contentType.matches('application/pdf') ||
        contentType.matches('image/.*') ||
        contentType == 'application/msword' ||
        contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
    }

    function isProductOwner(productId, userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isStreamOwner(streamId, userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isOrderParticipant(orderId, userId) {
      return request.auth != null && 
        (request.auth.uid == userId || hasRole('admin', request.auth));
    }

    function isOrderSeller(orderId, userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}