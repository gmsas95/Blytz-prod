{
  "rules": {
    "auctions": {
      "$auctionId": {
        ".read": true,
        ".write": "auth != null && (auth.uid == newData.child('sellerId').val() || auth.token.admin === true)",
        "bids": {
          ".write": "auth != null",
          "$bidId": {
            ".validate": "newData.hasChildren(['userId', 'amount', 'timestamp', 'status'])",
            "userId": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "amount": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "timestamp": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "status": {
              ".validate": "newData.isString() && (newData.val() === 'confirmed' || newData.val() === 'pending')"
            }
          }
        }
      }
    },
    "rateLimits": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid"
      }
    },
    "webhook_nonces": {
      "$nonce": {
        ".read": false,
        ".write": false
      }
    }
  }
}